{
	admin off
	auto_https off
}

:{$PORT:8080} {
	encode gzip
	root * /usr/share/caddy
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}
	handle /healthz {
		respond "ok" 200
	}
	handle {
		try_files {path} /index.html
		file_server
	}
}
